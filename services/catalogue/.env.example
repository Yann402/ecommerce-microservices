# Service Catalogue — variables d'environnement (dev local)
PORT=3002

# MongoDB : base dédiée au Catalogue (Database per Service)
MONGODB_URI=mongodb://localhost:27017/catalogue

# JWT : DOIT être identique au JWT_SECRET du service IAM ET au secret Kong,
# sinon la validation de signature échoue (401). Ne pas changer en dev.
JWT_SECRET=dev_secret_a_remplacer_en_production

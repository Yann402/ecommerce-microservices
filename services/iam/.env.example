# Service IAM — variables d'environnement (copier en .env)
PORT=3001
# PostgreSQL (via docker-compose infra)
DATABASE_URL="postgresql://ecom:ecom_dev_password@localhost:5432/iam?schema=public"
# JWT — en production, injecter via un secret (ADR-21 : K8s Secrets / Secrets Manager)
JWT_SECRET="dev_secret_a_remplacer_en_production"
JWT_EXPIRES_IN="1h"
